# BinRo Finance — Public Client Environment Configuration
# Copy this file to .env and replace placeholders with your real public credentials.
# NEVER put SUPABASE_SERVICE_ROLE_KEY, database passwords, or OAuth client secrets in this file.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
